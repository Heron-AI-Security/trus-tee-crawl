# Settings of the CI of the attested cluster (ADR-094, docs/ci-publishing.md). Read by setup-gcp.sh and smoke.sh.
# Every value can be overridden by an environment variable of the same name, so a change needs no edit of a script.
# The three values that the workflows read are NOT here: they are GitHub repository variables (GCP_PROJECT_ID, GCP_WIF_PROVIDER, GCP_SERVICE_ACCOUNT),
# which setup-gcp.sh prints; changing the project or the provider means changing those variables and re-running setup-gcp.sh.
PROJECT_ID="${PROJECT_ID:-training-custody}"
REGION="${REGION:-us-central1}"
ZONE="${ZONE:-us-central1-a}"
MACHINE_TYPE="${MACHINE_TYPE:-c3-standard-4}"            # the machine type of the dummy run (it must be the fleet's)
GITHUB_REPO="${GITHUB_REPO:-Heron-AI-Security/nutch-private}"
WIF_POOL="${WIF_POOL:-github}"
WIF_PROVIDER="${WIF_PROVIDER:-nutch-private}"
CI_SA_NAME="${CI_SA_NAME:-tc-github-ci}"                  # Google: 6 to 30 characters, lowercase letters, digits, hyphens, starts with a letter
# The tags that may use the identity (a run of CI starts by pushing one of these tags). The provider admits no other ref.
TAG_PREFIXES="${TAG_PREFIXES:-ci-smoke- publish-ref-}"
# The roles of the service account. Their rights must cover ops/ci/permissions.txt; smoke.sh checks it.
CI_ROLES="${CI_ROLES:-roles/compute.instanceAdmin.v1 roles/compute.storageAdmin}"
IMAGE_PREFIX="${IMAGE_PREFIX:-tc-img-}"
CHECK_IMAGE="${CHECK_IMAGE:-tc-img-rel-1}"               # read for its labels, for information (smoke.sh)

[Unit]
Description=Run the baked crawl once, after the four Hadoop daemons (no operator command)
Requires=tc-measure.service tc-fleet.service tc-namenode.service tc-resourcemanager.service
After=tc-measure.service tc-fleet.service tc-namenode.service tc-datanode.service tc-resourcemanager.service tc-nodemanager.service
ConditionPathExists=!/var/lib/tc-crawl/done
ConditionPathExists=/run/tc/role-master

[Service]
Type=oneshot
User=hadoop
Group=hadoop
StateDirectory=tc-crawl
Environment=JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64 HADOOP_HOME=/opt/hadoop HADOOP_CONF_DIR=/run/tc/conf HADOOP_LOG_DIR=/var/log/hadoop NUTCH_LOG_DIR=/var/log/hadoop PATH=/opt/hadoop/bin:/usr/bin:/bin
WorkingDirectory=/var/lib/hadoop
ExecStart=/usr/local/lib/tc/tc-crawl.sh
TimeoutStartSec=43200
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target

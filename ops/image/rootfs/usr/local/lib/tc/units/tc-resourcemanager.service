[Unit]
Description=Hadoop YARN ResourceManager (after the NameNode)
Requires=tc-measure.service tc-fleet.service tc-namenode.service
After=tc-measure.service tc-fleet.service tc-namenode.service

ConditionPathExists=/run/tc/role-master

[Service]
User=hadoop
Group=hadoop
Environment=JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64 HADOOP_HOME=/opt/hadoop HADOOP_CONF_DIR=/run/tc/conf HADOOP_LOG_DIR=/var/log/hadoop
WorkingDirectory=/var/lib/hadoop
ExecStart=/opt/hadoop/bin/yarn resourcemanager
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target

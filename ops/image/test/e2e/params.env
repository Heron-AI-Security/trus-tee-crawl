# The parameters of the baked crawl (step F0.3c). Read by /usr/local/lib/tc/tc-crawl.sh as data, never run as code: every line is KEY=VALUE with a capital key and a plain value.
# TEST OVERLAY (never pushed): 15 seeds of different kinds, 2 rounds, up to 15 fetch attempts per round, for the end to end test of 28 October 2026.
ROUNDS=2
NUM_FETCHERS=1
NUM_TASKS=1
SIZE_FETCHLIST=15
NUM_THREADS=2
TIME_LIMIT_FETCH=10
MAP_MEMORY_MB=2048
MAP_JAVA_OPTS=-Xmx1536m
REDUCE_MEMORY_MB=2048
REDUCE_JAVA_OPTS=-Xmx1536m
HDFS_SEED_DIR=/tc/seeds
HDFS_CRAWL_DIR=/tc/crawl
WAIT_FOR_CLUSTER_SECONDS=600
MIN_FETCHED=6
# The crawler's identity (ADR-066): sent to every site (http.agent.*) and written into every WARC file (warc.export.software). Measured with this file.
AGENT_NAME=training-custody-test-bot
AGENT_URL=https://github.com/Heron-AI-Security
WARC_SOFTWARE=Apache-Nutch-CommonCrawl-fork-training-custody
